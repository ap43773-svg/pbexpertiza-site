<svg width="300" height="300" viewBox="0 0 300 300" xmlns="http://www.w3.org/2000/svg">
  <!-- Группа элементов -->
  <g transform="translate(150, 150)">
    <!-- Зубья шестеренки (8 штук) -->
    <rect x="-15" y="-130" width="30" height="40" rx="5" fill="#0f4c81" />
    <rect x="-15" y="90" width="30" height="40" rx="5" fill="#0f4c81" />
    <rect x="90" y="-15" width="40" height="30" rx="5" fill="#0f4c81" />
    <rect x="-130" y="-15" width="40" height="30" rx="5" fill="#0f4c81" />
    
    <!-- Диагональные зубы -->
    <rect x="65" y="65" width="30" height="40" rx="5" fill="#0f4c81" transform="rotate(45 80 85)" />
    <rect x="-95" y="-95" width="30" height="40" rx="5" fill="#0f4c81" transform="rotate(45 -80 -85)" />
    <rect x="-95" y="65" width="30" height="40" rx="5" fill="#0f4c81" transform="rotate(-45 -80 85)" />
    <rect x="65" y="-95" width="30" height="40" rx="5" fill="#0f4c81" transform="rotate(-45 80 -85)" />

    <!-- Основной корпус шестеренки -->
    <circle cx="0" cy="0" r="90" fill="#0f4c81" />
    
    <!-- Белый внутренний круг (фон для текста) -->
    <circle cx="0" cy="0" r="70" fill="white" />
    
    <!-- Надпись ПБЭ -->
    <text x="0" y="15" font-family="'Segoe UI', Roboto, Arial, sans-serif" font-size="45" font-weight="800" fill="#0f4c81" text-anchor="middle" dominant-baseline="middle">ПБЭ</text>
  </g>
</svg>